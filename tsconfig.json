{
  "compilerOptions" : {
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "module": "commonjs",
    "moduleResolution": "node10",
    "sourceMap": true,
    "strictNullChecks": true,
    "noImplicitThis": true,
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist/main",
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "./src/*.ts",
    "./src/**/*.ts"
  ]
}
